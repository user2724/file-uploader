

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int @id @default(autoincrement())
  email String @unique
  name  String?
  password String
  files File[]

  
}

model File {
  id   Int @id @default(autoincrement())
  fileUrl String
  author User @relation(fields: [authorId], references: [id])
  authorId Int
}



model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}