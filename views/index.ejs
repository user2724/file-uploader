<html>

<body>


<h1>Welcome to Google Drive!</h1>

<% if (locals.user) { %>

 <h2>Welcome, <%= user.name %></h2> 
 

 <form action="/upload-file" method="POST" enctype="multipart/form-data">
    <h4>Add a new file:</h4>

    <label for="file-upload">Choose a file:</label>
     <input name="filename" type="file" id="file-upload">

    <button type="submit">Upload</button>
    </form>

<% if (files.length > 0) { %>
    <h2>My Files</h2>

<div class="all-files">
   <% files.forEach(file => { %>
        <h4><%= file.filename %></h4>
  <%  }) %>
</div>

<% } %>

<form action="/add-folder" method="POST">
<h4>Add folder (replace with button later) </h4>
<label for="folderName">Folder Name</label>
<input name="folderName" id="folderName" type="text">

<button type="submit">Add Folder</button>

</form>



<div class="folders-list">
    <% if (folders.length > 0) { %> 
        <h3>Folders:</h3>
       <% folders.forEach(folder => { %>
            <!--<form action="/access-form/<%= folder.folderName %>" method="GET">
                <button type="submit"><%= folder.folderName %></button>
            </form>-->
            <h4><%= folder.folderName %></h4>
      <%  }) %>
  <%  } %>
</div>

<form action="/log-out" method="POST">
    <button type="submit">Log Out</button>
</form>

<% } else { %>

<h1>Please Log In</h1>

<form action="/" method="POST">

    <label for="email">Email</label>
    <input name="email" type="email" id="email" required>
    
    <label for="password">Password</label>
    <input name="password" type="password" id="password" required>

    

    <button type="submit">Submit</button>

   <% if (errorMessage && errorMessage.length > 0) { %>
        <p><%= errorMessage[0] %></p>
    <% } %>

</form>

<h3>Don't have an account?</h3>
<a href="/sign-up">Sign Up</a>

<% } %>


</body>


</html>